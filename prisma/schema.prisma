generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Identity & Tenancy ───────────────────────────────────────────

enum RoleCode {
  SUPER_ADMIN
  SYSTEM_ADMIN
  DOC_ADMIN
  DEPT_HEAD
  DEPT_WORKER
  CONSULT_USER
}

enum UserStatus {
  ACTIVE
  BLOCKED
  INACTIVE
}

/// Estados del documento + flujo de aprobación por dependencia
enum DocumentStatus {
  DRAFT
  PENDING_REVIEW
  IN_REVIEW_DEPT
  REJECTED_DEPT
  APPROVED_DEPT
  IN_REVIEW_ARCHIVE
  REJECTED_ARCHIVE
  ARCHIVED
  ACTIVE
  ON_LOAN
  PENDING
  EXPIRED
  DELETED
  UNDER_REVIEW
  CLOSED
  TRANSFERRED
  HISTORICAL
}

enum WorkflowAction {
  CREATE
  SUBMIT
  APPROVE_DEPT
  REJECT_DEPT
  APPROVE_ARCHIVE
  REJECT_ARCHIVE
  RESUBMIT
  ARCHIVE
  COMMENT
}

enum LoanStatus {
  REQUESTED
  APPROVED
  REJECTED
  ACTIVE
  RETURNED
  OVERDUE
}

enum TransferStatus {
  DRAFT
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  COMPLETED
}

/// Ciclo vital documental — Ley 594 de 2000, art. 23 (AGN Colombia)
enum ArchivalPhase {
  MANAGEMENT /// Archivo de Gestión (fase activa)
  CENTRAL /// Archivo Central (fase semiactiva)
  HISTORICAL /// Archivo Histórico (fase inactiva / conservación permanente)
}

/// Tipo de transferencia según AGN / TRD
enum TransferKind {
  PRIMARY /// Gestión → Central
  SECONDARY /// Central → Histórico
  DISPOSAL /// Eliminación / disposición final según TRD
  INTERNAL /// Entre dependencias (mismo archivo)
}

enum InstrumentType {
  TRD
  TVD
  CCD
  PGD
  POLICY
}

/// Disposición final según TRD (AGN)
enum FinalDisposition {
  CONSERVATION
  SELECTION
  ELIMINATION
  DIGITALIZATION
}

/// Flujo legal de eliminación documental
enum DisposalStatus {
  DRAFT
  INVENTORY_PUBLISHED
  OBSERVATIONS
  TECHNICAL_REVIEW
  ACTA_PENDING
  APPROVED
  COMPLETED
  CANCELLED
}

enum LocationLevel {
  BUILDING /// Edificio
  FLOOR /// Piso
  ARCHIVE /// Archivo / depósito (compat)
  BLOCK /// Bloque (compat)
  ROOM /// Sala
  AISLE /// Pasillo (compat)
  SHELF /// Estantería
  LEVEL /// Nivel / entrepaño
  RACK /// Estantería alternativa
}

enum JobStatus {
  PENDING
  RUNNING
  COMPLETED
  FAILED
}

enum NotificationType {
  INFO
  WARNING
  SUCCESS
  ERROR
  ALERT
}

model Organization {
  id        String   @id @default(cuid())
  name      String
  nit       String?  @unique
  logoUrl   String?
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users            User[]
  dependencies     Dependency[]
  series           DocumentarySeries[]
  documentTypes    DocumentType[]
  documents        Document[]
  expedientes      Expediente[]
  locations        Location[]
  boxes            Box[]
  folders          Folder[]
  loans            Loan[]
  transfers        Transfer[]
  instruments      ArchivalInstrument[]
  disposalProcesses DisposalProcess[]
  physicalInventories PhysicalInventory[]
  trdVersions      TrdVersion[]
  settings         SystemSetting[]
  licenses         License[]
  backups          BackupRecord[]
  notifications    Notification[]
  auditLogs        AuditLog[]
  jobs             Job[]

  @@map("organizations")
}

model Role {
  id          String   @id @default(cuid())
  code        RoleCode @unique
  name        String
  description String?
  accessLevel Int      @default(20)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  users       User[]
  permissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          String   @id @default(cuid())
  module      String
  action      String
  code        String   @unique
  description String?
  createdAt   DateTime @default(now())

  roles RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  id           String @id @default(cuid())
  roleId       String
  permissionId String

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@unique([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id             String     @id @default(cuid())
  organizationId String
  roleId         String
  dependencyId   String?
  managerId      String?
  email          String
  passwordHash   String
  firstName      String
  lastName       String
  avatarUrl      String?
  status         UserStatus @default(ACTIVE)
  lastLoginAt    DateTime?
  mfaEnabled     Boolean    @default(false)
  mfaSecret      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  role         Role         @relation(fields: [roleId], references: [id])
  dependency   Dependency?  @relation(fields: [dependencyId], references: [id])
  manager      User?        @relation("UserManager", fields: [managerId], references: [id])
  teamMembers  User[]       @relation("UserManager")

  sessions         Session[]
  accessLogs       AccessLog[]
  auditLogs        AuditLog[]
  notifications    Notification[]
  documentsOwned   Document[]           @relation("DocumentResponsible")
  documentsSubmitted Document[]         @relation("DocumentSubmittedBy")
  expedientesOwned Expediente[]         @relation("ExpedienteResponsible")
  loansRequested   Loan[]               @relation("LoanRequester")
  loansApproved    Loan[]               @relation("LoanApprover")
  createdVersions  DocumentVersion[]
  workflowEvents   DocumentWorkflowEvent[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@index([dependencyId])
  @@index([managerId])
  @@index([roleId])
  @@map("users")
}

model Session {
  id               String   @id @default(cuid())
  userId           String
  tokenHash        String   @unique
  ipAddress        String?
  userAgent        String?
  expiresAt        DateTime
  createdAt        DateTime @default(now())
  revokedAt        DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

model AccessLog {
  id        String   @id @default(cuid())
  userId    String?
  email     String?
  success   Boolean
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User? @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([userId])
  @@map("access_logs")
}

// ─── Organizations structure ──────────────────────────────────────

model Dependency {
  id             String    @id @default(cuid())
  organizationId String
  /// Código institucional TRD (ej. 20 Gerencia, 30 Jurídica)
  code           String
  name           String
  description    String?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  users        User[]
  documents    Document[]
  expedientes  Expediente[]
  series       DocumentarySeries[]

  @@unique([organizationId, code])
  @@index([organizationId, active])
  @@map("dependencies")
}

model DocumentarySeries {
  id             String    @id @default(cuid())
  organizationId String
  dependencyId   String?
  instrumentId   String?
  /// Código de serie en TRD (ej. 01 Acciones Constitucionales, 02 Actas)
  code           String
  name           String
  description    String?
  procedure      String?
  retentionYears Int?
  /// Años en Archivo de Gestión (TRD)
  retentionManagementYears Int?
  /// Años en Archivo Central (TRD)
  retentionCentralYears    Int?
  finalDisposition FinalDisposition @default(CONSERVATION)
  /// Valores documentales (pueden coexistir)
  valueAdministrative Boolean @default(false)
  valueJuridical      Boolean @default(false)
  valueLegal          Boolean @default(false)
  valueFiscal         Boolean @default(false)
  valueAccounting     Boolean @default(false)
  valueHistorical     Boolean @default(false)
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  organization Organization          @relation(fields: [organizationId], references: [id])
  dependency   Dependency?           @relation(fields: [dependencyId], references: [id])
  instrument   ArchivalInstrument?   @relation(fields: [instrumentId], references: [id])
  subseries    DocumentarySubseries[]
  documents    Document[]

  @@unique([organizationId, code])
  @@index([organizationId])
  @@index([dependencyId])
  @@index([instrumentId])
  @@map("documentary_series")
}

model DocumentarySubseries {
  id        String   @id @default(cuid())
  seriesId  String
  code      String
  name      String
  description String?
  retentionManagementYears Int?
  retentionCentralYears    Int?
  finalDisposition FinalDisposition?
  valueAdministrative Boolean @default(false)
  valueJuridical      Boolean @default(false)
  valueLegal          Boolean @default(false)
  valueFiscal         Boolean @default(false)
  valueAccounting     Boolean @default(false)
  valueHistorical     Boolean @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  series    DocumentarySeries @relation(fields: [seriesId], references: [id], onDelete: Cascade)
  documents Document[]

  @@unique([seriesId, code])
  @@map("documentary_subseries")
}

model DocumentType {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  name           String
  /// TYPOLOGY = tipología TRD · FORMAT = soporte/formato
  category       String   @default("FORMAT")
  description    String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])
  documents    Document[]

  @@unique([organizationId, code])
  @@map("document_types")
}

// ─── Documents & Expedientes ──────────────────────────────────────

model Expediente {
  id             String         @id @default(cuid())
  organizationId String
  dependencyId   String
  responsibleId  String?
  code           String
  name           String
  description    String?
  status         DocumentStatus @default(ACTIVE)
  archivalPhase  ArchivalPhase  @default(MANAGEMENT)
  openedAt       DateTime       @default(now())
  closedAt       DateTime?
  transferredAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  dependency   Dependency   @relation(fields: [dependencyId], references: [id])
  responsible  User?        @relation("ExpedienteResponsible", fields: [responsibleId], references: [id])
  documents    Document[]

  @@unique([organizationId, code])
  @@index([organizationId, dependencyId, status])
  @@index([organizationId, archivalPhase])
  @@index([organizationId, deletedAt, createdAt])
  @@map("expedientes")
}

model Document {
  id             String         @id @default(cuid())
  organizationId String
  dependencyId   String
  expedienteId   String?
  seriesId       String?
  subseriesId    String?
  documentTypeId String?
  folderId       String?
  responsibleId  String?
  submittedById  String?
  code           String
  qrCode         String         @unique
  barcode        String?        @unique
  name           String
  description    String?
  status         DocumentStatus @default(DRAFT)
  archivalPhase  ArchivalPhase  @default(MANAGEMENT)
  folioCount     Int            @default(1)
  /// Foliación verificada (requisito de transferencia)
  foliationVerified Boolean     @default(false)
  chronologicalOrder Boolean    @default(false)
  documentDate   DateTime?
  observations   String?
  workflowNotes  String?
  imageUrl       String?
  filePath       String?
  fileHash       String?
  searchText     String?
  /// Retención/disposición calculadas desde TRD / valores
  appliedRetentionMgmt Int?
  appliedRetentionCentral Int?
  appliedFinalDisposition FinalDisposition?
  retentionDueAt DateTime?
  submittedAt    DateTime?
  approvedDeptAt DateTime?
  archivedAt     DateTime?
  transferredAt  DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  deletedAt      DateTime?

  organization Organization          @relation(fields: [organizationId], references: [id])
  dependency   Dependency            @relation(fields: [dependencyId], references: [id])
  expediente   Expediente?           @relation(fields: [expedienteId], references: [id])
  series       DocumentarySeries?    @relation(fields: [seriesId], references: [id])
  subseries    DocumentarySubseries? @relation(fields: [subseriesId], references: [id])
  documentType DocumentType?         @relation(fields: [documentTypeId], references: [id])
  folder       Folder?               @relation(fields: [folderId], references: [id])
  responsible  User?                 @relation("DocumentResponsible", fields: [responsibleId], references: [id])
  submittedBy  User?                 @relation("DocumentSubmittedBy", fields: [submittedById], references: [id])

  versions       DocumentVersion[]
  attachments    DocumentAttachment[]
  loans          Loan[]
  signatures     DigitalSignature[]
  workflowEvents DocumentWorkflowEvent[]

  @@unique([organizationId, code])
  @@index([organizationId, dependencyId, status])
  @@index([organizationId, archivalPhase])
  @@index([organizationId, deletedAt, createdAt])
  @@index([submittedById])
  @@index([qrCode])
  @@index([barcode])
  @@index([name])
  @@index([searchText])
  @@map("documents")
}

model DocumentWorkflowEvent {
  id           String         @id @default(cuid())
  documentId   String
  actorId      String?
  action       WorkflowAction
  fromStatus   DocumentStatus?
  toStatus     DocumentStatus?
  observations String?
  createdAt    DateTime       @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id])

  @@index([documentId, createdAt])
  @@index([actorId])
  @@map("document_workflow_events")
}

model DocumentVersion {
  id          String   @id @default(cuid())
  documentId  String
  version     Int
  filePath    String?
  fileHash    String?
  changeNote  String?
  createdById String?
  createdAt   DateTime @default(now())

  document  Document @relation(fields: [documentId], references: [id], onDelete: Cascade)
  createdBy User?    @relation(fields: [createdById], references: [id])

  @@unique([documentId, version])
  @@index([documentId])
  @@map("document_versions")
}

model DocumentAttachment {
  id         String   @id @default(cuid())
  documentId String
  name       String
  filePath   String
  mimeType   String?
  sizeBytes  Int?
  createdAt  DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("document_attachments")
}

model DigitalSignature {
  id         String   @id @default(cuid())
  documentId String
  signerName String
  signatureData String
  hash       String
  signedAt   DateTime @default(now())

  document Document @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("digital_signatures")
}

// ─── Physical archive ─────────────────────────────────────────────

model Location {
  id             String        @id @default(cuid())
  organizationId String
  parentId       String?
  level          LocationLevel
  code           String
  name           String
  active         Boolean       @default(true)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  parent       Location?    @relation("LocationTree", fields: [parentId], references: [id])
  children     Location[]   @relation("LocationTree")
  boxes        Box[]

  @@unique([organizationId, code])
  @@index([organizationId, level])
  @@index([parentId])
  @@map("locations")
}

model Box {
  id             String    @id @default(cuid())
  organizationId String
  locationId     String?
  code           String
  qrCode         String    @unique
  capacity       Int       @default(50)
  currentCount   Int       @default(0)
  status         String    @default("AVAILABLE")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  location     Location?    @relation(fields: [locationId], references: [id])
  folders      Folder[]

  @@unique([organizationId, code])
  @@index([organizationId, deletedAt])
  @@map("boxes")
}

model Folder {
  id             String    @id @default(cuid())
  organizationId String
  boxId          String?
  code           String
  name           String?
  color          String    @default("#2563EB")
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  deletedAt      DateTime?

  organization Organization @relation(fields: [organizationId], references: [id])
  box          Box?         @relation(fields: [boxId], references: [id])
  documents    Document[]

  @@unique([organizationId, code])
  @@index([organizationId, boxId])
  @@map("folders")
}

// ─── Loans & Transfers ────────────────────────────────────────────

model Loan {
  id             String     @id @default(cuid())
  organizationId String
  documentId     String
  requesterId    String
  approverId     String?
  code           String
  status         LoanStatus @default(REQUESTED)
  requestedAt    DateTime   @default(now())
  approvedAt     DateTime?
  dueDate        DateTime?
  returnedAt     DateTime?
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  document     Document     @relation(fields: [documentId], references: [id])
  requester    User         @relation("LoanRequester", fields: [requesterId], references: [id])
  approver     User?        @relation("LoanApprover", fields: [approverId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, status, dueDate])
  @@index([documentId])
  @@map("loans")
}

model Transfer {
  id               String         @id @default(cuid())
  organizationId   String
  code             String
  title            String
  kind             TransferKind   @default(INTERNAL)
  fromPhase        ArchivalPhase?
  toPhase          ArchivalPhase?
  fromDependency   String?
  toDependency     String?
  status           TransferStatus @default(PENDING)
  scheduledAt      DateTime?
  completedAt      DateTime?
  notes            String?
  /// Checklist obligatorio AGN / TRD
  checklistFoliation     Boolean @default(false)
  checklistChronological Boolean @default(false)
  checklistInventory     Boolean @default(false)
  checklistBoxFolder     Boolean @default(false)
  inventoryFilePath      String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])
  items        TransferItem[]

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@index([organizationId, kind])
  @@map("transfers")
}

model TransferItem {
  id           String  @id @default(cuid())
  transferId   String
  documentId   String?
  expedienteId String?
  notes        String?

  transfer Transfer @relation(fields: [transferId], references: [id], onDelete: Cascade)

  @@index([transferId])
  @@map("transfer_items")
}

model ArchivalInstrument {
  id             String         @id @default(cuid())
  organizationId String
  type           InstrumentType
  name           String
  version        String
  seriesCount    Int            @default(0)
  lastUpdated    DateTime       @default(now())
  approvedAt     DateTime?
  active         Boolean        @default(true)
  notes          String?
  filePath       String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization       @relation(fields: [organizationId], references: [id])
  series       DocumentarySeries[]

  @@index([organizationId, type])
  @@map("archival_instruments")
}

model DisposalProcess {
  id             String         @id @default(cuid())
  organizationId String
  code           String
  title          String
  status         DisposalStatus @default(DRAFT)
  inventoryNote  String?
  observations   String?
  technicalConcept String?
  actaNote       String?
  documentIds    Json?
  inventoryFilePath String?
  actaFilePath   String?
  /// Expediente que conserva el historial de la eliminación
  historyExpedienteId String?
  publishedAt    DateTime?
  completedAt    DateTime?
  createdById    String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId, status])
  @@map("disposal_processes")
}

model PhysicalInventory {
  id             String   @id @default(cuid())
  organizationId String
  code           String
  title          String
  locationId     String?
  notes          String?
  filePath       String?
  itemCount      Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@index([organizationId])
  @@map("physical_inventories")
}

model TrdVersion {
  id             String   @id @default(cuid())
  organizationId String
  instrumentId   String?
  version        String
  notes          String?
  snapshot       Json
  seriesCount    Int      @default(0)
  createdById    String?
  createdAt      DateTime @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@index([organizationId, createdAt])
  @@map("trd_versions")
}

// ─── System ───────────────────────────────────────────────────────

model AuditLog {
  id             String   @id @default(cuid())
  organizationId String?
  userId         String?
  action         String
  module         String
  entityType     String?
  entityId       String?
  changes        Json?
  ipAddress      String?
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@index([organizationId, createdAt])
  @@index([userId, createdAt])
  @@index([module, action])
  @@map("audit_logs")
}

model Notification {
  id             String           @id @default(cuid())
  organizationId String?
  userId         String?
  type           NotificationType @default(INFO)
  title          String
  message        String
  read           Boolean          @default(false)
  link           String?
  createdAt      DateTime         @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])
  user         User?         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read, createdAt])
  @@index([organizationId, createdAt])
  @@map("notifications")
}

model SystemSetting {
  id             String   @id @default(cuid())
  organizationId String?
  key            String
  value          Json
  updatedAt      DateTime @updatedAt

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, key])
  @@map("system_settings")
}

model License {
  id             String    @id @default(cuid())
  organizationId String
  licenseKey     String    @unique
  plan           String
  seats          Int       @default(50)
  expiresAt      DateTime?
  active         Boolean   @default(true)
  createdAt      DateTime  @default(now())

  organization Organization @relation(fields: [organizationId], references: [id])

  @@map("licenses")
}

model BackupRecord {
  id             String   @id @default(cuid())
  organizationId String?
  filePath       String
  sizeBytes      Int?
  status         String   @default("COMPLETED")
  createdAt      DateTime @default(now())

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([createdAt])
  @@map("backup_records")
}

model Job {
  id             String    @id @default(cuid())
  organizationId String?
  type           String
  payload        Json?
  status         JobStatus @default(PENDING)
  result         Json?
  error          String?
  createdAt      DateTime  @default(now())
  startedAt      DateTime?
  finishedAt     DateTime?

  organization Organization? @relation(fields: [organizationId], references: [id])

  @@index([status, createdAt])
  @@map("jobs")
}

model RecycleBinItem {
  id         String   @id @default(cuid())
  entityType String
  entityId   String
  payload    Json
  deletedBy  String?
  deletedAt  DateTime @default(now())

  @@index([entityType, deletedAt])
  @@map("recycle_bin")
}
