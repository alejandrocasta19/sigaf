DATABASE_URL="postgresql://sigaf:CHANGE_ME_STRONG_DB_PASSWORD@localhost:5432/sigaf?schema=public&connection_limit=10&pool_timeout=20"
JWT_SECRET="CHANGE_ME_TO_A_LONG_RANDOM_SECRET_MIN_32_CHARS"
JWT_EXPIRES_IN="8h"
CSRF_SECRET="CHANGE_ME_CSRF_SECRET_MIN_24_CHARS"
APP_URL="http://localhost:3000"
UPLOAD_DIR="./uploads"
NODE_ENV="development"
# Producción (internet):
# NODE_ENV="production"
# APP_URL="https://sigaf.ejemplo.gov.co"
# FORCE_HTTPS="true"
# ALLOW_HTTP="false"
# REQUIRE_ADMIN_MFA="true"
# API_RATE_MAX="120"
# LOGIN_RATE_MAX="20"
# Antivirus opcional (ClamAV) — se ejecuta en el worker, no en el request:
# CLAMAV_ENABLED="true"
# CLAMAV_BIN="clamdscan"
# SMTP opcional
# SMTP_HOST="smtp.example.com"
# SMTP_PORT="587"
# SMTP_USER=""
# SMTP_PASS=""
# SMTP_FROM="sigaf@example.com"
# SMTP_SECURE="false"

# Redis (cola + rate limit + caché dashboard)
REDIS_URL="redis://127.0.0.1:6379"

# Storage: local (dev sin MinIO) | s3 (MinIO / S3-compatible)
STORAGE_DRIVER="local"
# STORAGE_DRIVER="s3"
# S3_ENDPOINT="http://127.0.0.1:9000"
# S3_PUBLIC_URL="http://127.0.0.1:9000"
# S3_REGION="us-east-1"
# S3_BUCKET="sigaf-docs"
# S3_ACCESS_KEY="sigafminio"
# S3_SECRET_KEY="sigafminio_change_me"
# S3_FORCE_PATH_STYLE="true"

# Límites de subida (MB) — configurar según contrato de almacenamiento COOTRANSHUILA
UPLOAD_MAX_MB="20"
UPLOAD_MAX_PDF_MB="20"
UPLOAD_MAX_IMAGE_MB="10"
UPLOAD_MAX_OFFICE_MB="20"

# PgBouncer (cuando haya 3+ réplicas SIGAF): apuntar DATABASE_URL al proxy, pgbouncer=true
# DATABASE_URL="postgresql://sigaf:...@pgbouncer:6432/sigaf?schema=public&pgbouncer=true"
